<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-feature android:name="android.hardware.microphone" android:required="true"/>
    <!-- Sin permiso INTERNET: la APK resultante no puede descargar nada. -->
    <application android:label="Visor Turco Español Sin Internet" android:allowBackup="false" android:usesCleartextTraffic="false">
        <activity android:name=".TurcoTranslatorKeyboard$PreparacionActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <service android:name=".TurcoTranslatorKeyboard" android:exported="true"
                 android:permission="android.permission.BIND_INPUT_METHOD"
                 android:label="Visor Turco Español Sin Internet">
            <intent-filter><action android:name="android.view.InputMethod"/></intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method"/>
        </service>
    </application>
</manifest>


